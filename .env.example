# Copiar a .env y completar. Nunca commitear .env real.
DATABASE_URL=postgresql+psycopg://modulo1_app:app-dev-local-1@localhost:5432/modulo1
DATABASE_URL_MIGRATIONS=postgresql+psycopg://modulo1_owner:owner-dev-local-1@localhost:5432/modulo1
JWT_SECRET=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14
TENANT_DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires
# Storage de evidencia (8.5) — backend local para desarrollo
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage_local
STORAGE_LOCAL_BASE_URL=/v1/storage
# Worker (8.4/8.6)
WORKER_POLL_SEG=5
