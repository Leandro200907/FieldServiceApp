# Copiar a .env y completar. Nunca commitear un .env real (.gitignore los excluye).
# Precedencia (API, worker, Alembic, scripts): variables del proceso > archivo ENV_FILE > .env (solo si ENV_FILE no está).

# Rol de APLICACIÓN (sin BYPASSRLS, nunca owner). Lo usan la API, el worker y los scripts.
DATABASE_URL=postgresql+psycopg://modulo1_app:CAMBIAR@localhost:5432/modulo1
# Rol OWNER: SOLO la lee migrations/env.py (alembic) y scripts/generar_schema.py.
DATABASE_URL_MIGRATIONS=postgresql+psycopg://modulo1_owner:CAMBIAR@localhost:5432/modulo1

# JWT (9.2). Secreto largo y aleatorio; distinto por entorno.
JWT_SECRET=CAMBIAR-por-un-secreto-aleatorio-largo
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14

# Zona horaria por defecto del tenant (fallback; cada tenant tiene la suya en la base)
TENANT_DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires

# Storage de evidencia (8.5). Backend local para desarrollo; secreto de firma DISTINTO del JWT.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage_local
STORAGE_LOCAL_BASE_URL=/v1/storage
STORAGE_SECRET=CAMBIAR-por-otro-secreto-distinto-del-jwt
# STORAGE_MAX_BYTES=26214400

# Canales de notificación (plataforma; el tenant habilita cada canal con configurar_canales)
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alertas@ejemplo.com
# TELEGRAM_BOT_TOKEN=
# Drive (solo lectura; cuenta de servicio de la plataforma, el tenant comparte su carpeta con ese mail)
# DRIVE_SERVICE_ACCOUNT_JSON=  (o DRIVE_SERVICE_ACCOUNT_FILE=/ruta/cuenta.json)
# Paquete público (opcional; si falta se deriva del JWT_SECRET con dominio propio)
# PAQUETE_SECRET=

# Worker: cadencia del loop y umbral de readiness (latido global más viejo que esto → /salud/listo 503)
WORKER_POLL_SEG=5
WORKER_LATIDO_MAX_SEG=120
WORKER_LOG_LEVEL=INFO
