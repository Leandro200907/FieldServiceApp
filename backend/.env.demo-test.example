# Copiar a .env.demo-test solo para pytest tests/test_sembrar_demo.py (destructivo: --reset).
# No usar fsm_demo. Crear base: psql -h 127.0.0.1 -v db=modulo1_ci_demo -f scripts/crear_base.sql
# Correr siempre con ENV_FILE explícito: ENV_FILE=.env.demo-test python -m pytest -q tests/test_sembrar_demo.py
#   (PowerShell: $env:ENV_FILE=".env.demo-test"; python -m pytest -q tests/test_sembrar_demo.py)

DATABASE_URL=postgresql+psycopg://modulo1_app:CAMBIAR@127.0.0.1:5432/modulo1_ci_demo
DATABASE_URL_MIGRATIONS=postgresql+psycopg://modulo1_owner:CAMBIAR@127.0.0.1:5432/modulo1_ci_demo
DATABASE_URL_ADMIN=postgresql://postgres:CAMBIAR@127.0.0.1:5432/postgres
DEMO_PASSWORD=demo-secreto-12

JWT_SECRET=desarrollo-demo-test-jwt-secret-minimo-32-chars
STORAGE_SECRET=desarrollo-demo-test-storage-secret-min-32-chars
STORAGE_LOCAL_DIR=./storage_local_demo_test
TENANT_DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires
