# Copiar a .env.test y completar. Uso exclusivo de pytest local (nunca fsm_demo).
#   set ENV_FILE=.env.test   (PowerShell: $env:ENV_FILE=".env.test")
#   python -m pytest -q --ignore=tests/test_sembrar_demo.py
#
# Crear la base una vez (como postgres):
#   psql -v db=modulo1_test -f scripts/crear_base.sql
#   python -m alembic upgrade head

DATABASE_URL=postgresql+psycopg://modulo1_app:CAMBIAR@localhost:5432/modulo1_test
DATABASE_URL_MIGRATIONS=postgresql+psycopg://modulo1_owner:CAMBIAR@localhost:5432/modulo1_test

JWT_SECRET=desarrollo-test-jwt-secret-minimo-32-caracteres
STORAGE_SECRET=desarrollo-test-storage-secret-minimo-32-chars
STORAGE_LOCAL_DIR=./storage_local_test
TENANT_DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires

# Tests de sembrado demo (solo pytest tests/test_sembrar_demo.py): usar otra copia
# .env.demo-test.example → modulo1_ci_demo, nunca fsm_demo.
